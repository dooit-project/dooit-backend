TODOLAB_MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
TODOLAB_MYSQL_DATABASE=todolab
TODOLAB_DB_URL=jdbc:mysql://mysql:3306/todolab
TODOLAB_DB_USERNAME=todolab
TODOLAB_DB_PASSWORD=replace-with-a-different-long-random-password

# Use the final HTTPS API origin. Tailscale is still valid, and a purchased domain can replace it.
TODOLAB_JWT_ISSUER=https://your-device.your-tailnet.ts.net
# Generate with: openssl rand -base64 48
TODOLAB_JWT_SECRET=replace-with-at-least-32-random-bytes
TODOLAB_JWT_ACCESS_TOKEN_TTL=PT15M
TODOLAB_GUEST_JWT_ACCESS_TOKEN_TTL=P31D
TODOLAB_PASSWORD_RESET_TOKEN_TTL=PT30M
TODOLAB_PASSWORD_RESET_RATE_LIMIT_WINDOW=PT1H
TODOLAB_PASSWORD_RESET_MAX_REQUESTS_PER_WINDOW=5
TODOLAB_PASSWORD_RESET_LINK_TEMPLATE=todolab://password-reset?token={token}
TODOLAB_REFRESH_TOKEN_IDLE_TTL=P30D
TODOLAB_REFRESH_TOKEN_ABSOLUTE_TTL=P90D

# Native Android requests are not subject to browser CORS. Leave empty unless Expo Web is used.
TODOLAB_ALLOWED_ORIGINS=

# Optional production verification inputs. Keep the real values out of committed docs/logs.
TODOLAB_TAILSCALE_API_URL=https://your-device.your-tailnet.ts.net
TODOLAB_PUBLIC_API_URL=https://api.example.com
TODOLAB_TAILSCALE_CLI=tailscale
TODOLAB_WEB_ORIGIN=
TODOLAB_EXPO_WEB_ORIGIN=

# Optional daily email. Keep the scheduler disabled when these are empty.
TODOLAB_MAIL_USERNAME=
TODOLAB_MAIL_PASSWORD=
TODOLAB_DAILY_SUMMARY_TO=
APP_BATCH_SCHEDULER_ENABLED=false

# Optional image tag for release/rollback. The release script defaults to the current git short SHA.
TODOLAB_APP_IMAGE_TAG=local

# Optional local production operation paths. Use an external/synced location for offsite backup copies.
TODOLAB_BACKUP_DIR=/Users/hyunseung/todolab-backups
TODOLAB_OFFSITE_BACKUP_DIR=
TODOLAB_PRODUCTION_LAUNCHD_LABEL=com.todolab.backend.production
TODOLAB_PRODUCTION_LAUNCHD_INTERVAL_SECONDS=300
