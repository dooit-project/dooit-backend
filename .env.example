DOOIT_MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
DOOIT_MYSQL_DATABASE=dooit
DOOIT_DB_URL=jdbc:mysql://mysql:3306/dooit
DOOIT_DB_USERNAME=dooit
DOOIT_DB_PASSWORD=replace-with-a-different-long-random-password

# Use the final HTTPS API origin. Tailscale is still valid, and a purchased domain can replace it.
DOOIT_JWT_ISSUER=https://your-device.your-tailnet.ts.net
# Generate with: openssl rand -base64 48
DOOIT_JWT_SECRET=replace-with-at-least-32-random-bytes
DOOIT_JWT_ACCESS_TOKEN_TTL=PT15M
DOOIT_GUEST_JWT_ACCESS_TOKEN_TTL=P31D
DOOIT_PASSWORD_RESET_TOKEN_TTL=PT30M
DOOIT_PASSWORD_RESET_RATE_LIMIT_WINDOW=PT1H
DOOIT_PASSWORD_RESET_MAX_REQUESTS_PER_WINDOW=5
DOOIT_PASSWORD_RESET_LINK_TEMPLATE=dooit://password-reset?token={token}
DOOIT_REFRESH_TOKEN_IDLE_TTL=P30D
DOOIT_REFRESH_TOKEN_ABSOLUTE_TTL=P90D

# Native Android requests are not subject to browser CORS. Leave empty unless Expo Web is used.
DOOIT_ALLOWED_ORIGINS=

# Optional production verification inputs. Keep the real values out of committed docs/logs.
DOOIT_TAILSCALE_API_URL=https://your-device.your-tailnet.ts.net
DOOIT_PUBLIC_API_URL=https://api.example.com
DOOIT_TAILSCALE_CLI=tailscale
DOOIT_WEB_ORIGIN=
DOOIT_EXPO_WEB_ORIGIN=

# Optional daily email. Keep the scheduler disabled when these are empty.
DOOIT_MAIL_USERNAME=
DOOIT_MAIL_PASSWORD=
DOOIT_DAILY_SUMMARY_TO=
APP_BATCH_SCHEDULER_ENABLED=false

# Optional image tag for release/rollback. The release script defaults to the current git short SHA.
DOOIT_APP_IMAGE_TAG=local

# Optional local production operation paths. Use an external/synced location for offsite backup copies.
DOOIT_BACKUP_DIR=/Users/hyunseung/dooit-backups
DOOIT_OFFSITE_BACKUP_DIR=
DOOIT_PRODUCTION_LAUNCHD_LABEL=pj.dooit.backend.production
DOOIT_PRODUCTION_LAUNCHD_INTERVAL_SECONDS=300
