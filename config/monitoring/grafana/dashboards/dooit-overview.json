{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "dooit-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "expr": "up{job=\"dooit-backend\"}",
          "refId": "A"
        }
      ],
      "title": "Backend Up",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "dooit-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"dooit-backend\",uri=~\"/api/.*\"}[5m]))",
          "legendFormat": "requests",
          "refId": "A"
        }
      ],
      "title": "API Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "dooit-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"dooit-backend\",uri=~\"/api/.*\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "title": "API Latency p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "dooit-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"dooit-backend\"}) by (area)",
          "legendFormat": "{{area}}",
          "refId": "A"
        }
      ],
      "title": "JVM Memory Used",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "dooit-prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 5,
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=\"dooit-backend\"}",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{job=\"dooit-backend\"}",
          "legendFormat": "idle",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{job=\"dooit-backend\"}",
          "legendFormat": "pending",
          "refId": "C"
        }
      ],
      "title": "HikariCP Connections",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "dooit-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 7,
      "targets": [
        {
          "expr": "((sum(rate(http_server_requests_seconds_count{job=\"dooit-backend\",uri=~\"/api/.*\",status=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_server_requests_seconds_count{job=\"dooit-backend\",uri=~\"/api/.*\"}[5m])))",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "title": "API 5xx Error Ratio",
      "type": "timeseries",
      "description": "최근 5분 API 요청 중 5xx 비율. 요청이 없으면 No data/NaN이며 서버 상태는 Backend Up을 함께 확인합니다."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "dooit-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 8,
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"dooit-backend\",uri=~\"/api/.*\",status=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "5xx count",
          "refId": "A"
        }
      ],
      "title": "API 5xx Count (5m)",
      "type": "timeseries",
      "description": "최근 5분 5xx 증가량. Prometheus 경계 보간으로 소수가 나올 수 있습니다."
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "dooit-loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{compose_service=\"app\"} |= \"ERROR\"",
          "refId": "A"
        }
      ],
      "title": "Recent App Errors",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "dooit",
    "production"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Dooit Production Overview",
  "uid": "dooit-production-overview",
  "version": 1,
  "weekStart": ""
}
